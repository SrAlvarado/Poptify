{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Poptify",
  "version": "0.3.3",
  "identifier": "com.poptify.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:17420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Poptify",
        "width": 520,
        "height": 620,
        "minWidth": 320,
        "minHeight": 200,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false,
        "skipTaskbar": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval' https://w.soundcloud.com https://connect.soundcloud.com https://www.youtube.com https://s.ytimg.com; frame-src https://w.soundcloud.com https://www.youtube.com https://www.youtube-nocookie.com; connect-src 'self' ipc: http://ipc.localhost https://api-widget.soundcloud.com https://api.soundcloud.com https://www.youtube.com https://s.ytimg.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEzNEJEQUZDOTlDNDFCNzUKUldSMUc4U1ovTnBMbzZERXA4b0J0WUZrbUgxb0UreFRoL1hvR29SZTlNdWRTZHk0ZDl6Z2VRdzIK",
      "endpoints": [
        "https://github.com/SrAlvarado/Poptify/releases/latest/download/latest.json"
      ]
    }
  }
}
